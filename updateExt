#!/bin/bash
set -euo pipefail

command -v jq >/dev/null 2>&1 || { echo "jq is required but not installed." >&2; exit 1; }
command -v code >/dev/null 2>&1 || { echo "VS Code CLI (code) is required but not found." >&2; exit 1; }

DOWNLOAD_URL=$(curl -fsSL https://api.github.com/repos/justinearl/json-log-viewer/releases/latest \
    | jq -r '.assets[] | select(.name | endswith("vsix")) | .browser_download_url')

if [ -z "$DOWNLOAD_URL" ] || [ "$DOWNLOAD_URL" = "null" ]; then
    echo "No .vsix asset found in the latest release." >&2
    exit 1
fi

curl -fSL -o logviewer-latest.vsix "$DOWNLOAD_URL"
code --install-extension logviewer-latest.vsix
rm -f logviewer-latest.vsix

echo "Extension installed successfully."
