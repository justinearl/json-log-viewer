#!/bin/bash
set -euo pipefail

repo_url="https://github.com/justinearl/json-log-viewer"

format_commit() {
    local commit_hash="${1%% *}"
    local message="${1#* }"

    case "$message" in
        bump-version*|changelog*)
            return
            ;;
    esac

    echo "- $message [[${commit_hash}](${repo_url}/commit/${commit_hash})]"
}

echo "# Change Log"
echo ""
echo "All notable changes to the \"logviewer\" extension will be documented in this file."
echo ""

tags=$(git tag --sort=-version:refname)

previous_tag=""
for tag in $tags; do
    echo "## [$tag]"

    if previous_tag=$(git describe --tags --abbrev=0 "${tag}^" 2>/dev/null); then
        git log --pretty="%h %s" "${previous_tag}..${tag}" | while IFS= read -r line; do
            format_commit "$line"
        done
    else
        git log --pretty="%h %s" "${tag}" | while IFS= read -r line; do
            format_commit "$line"
        done
    fi
done
