{
  "name": "logviewer",
  "displayName": "log-viewer",
  "description": "This is use to view filebeat like logs",
  "version": "1.3.1",
  "publisher": "justinearl",
  "license": "MIT",
  "icon": "assets/images/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:justinearl/json-log-viewer.git"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "logviewer.jsonview",
        "title": "Open in JSON Log Viewer"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == log || resourceExtname =~ /\\.(log|jsonl|ndjson|json|txt)$/",
          "group": "navigation",
          "command": "logviewer.jsonview"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceLangId == log || resourceExtname =~ /\\.(log|jsonl|ndjson|json|txt)$/",
          "group": "navigation",
          "command": "logviewer.jsonview"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "logviewer.jsonLog",
        "displayName": "JSON Log Viewer",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          },
          {
            "filenamePattern": "*.log"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.10.0",
    "ovsx": "^1.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}